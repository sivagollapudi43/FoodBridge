# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Local MongoDB or MongoDB Atlas URI)
# Example Local: mongodb://127.0.0.1:27017/foodbridge
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/foodbridge?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/foodbridge

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Authentication Secrets (for upcoming JWT and bcrypt implementation)
JWT_SECRET=supersecret_jwt_key_change_in_production_foodbridge_2026
JWT_EXPIRES_IN=7d

